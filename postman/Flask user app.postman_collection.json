          "body": "[{\"address\":\"Hamra, Beirut\",\"country\":\"Lebanon\",\"email\":\"maya@example.com\",\"name\":\"Maya Haddad\",\"phone\":\"01-555-0101\",\"user_id\":1},{\"address\":\"Hamra, Beirut\",\"country\":\"Lebanon\",\"email\":\"omar@example.com\",\"name\":\"Omar Saleh\",\"phone\":\"01-555-0102\",\"user_id\":2}]\n"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const responseData = pm.response.json();",
              "pm.test(\"Response is an array\", () => pm.expect(responseData).to.be.an(\"array\"));",
              "pm.test(\"New user is listed\", () => pm.expect(responseData.some(u => u.user_id === Number(pm.environment.get(\"user_id\")))).to.be.true);"
            ]
          }
        }
      ]
