  "item": [
    {
      "name": "01 Add user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "add"
          ]
        },
        "description": "Create a fictional user and save the generated ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Omar Saleh\",\n  \"email\": \"omar@example.com\",\n  \"phone\": \"01-555-0102\",\n  \"address\": \"Hamra, Beirut\",\n  \"country\": \"Lebanon\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [
        {
          "name": "201 CREATED",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "add"
              ]
            },
            "description": "Create a fictional user and save the generated ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Omar Saleh\",\n  \"email\": \"omar@example.com\",\n  \"phone\": \"01-555-0102\",\n  \"address\": \"Hamra, Beirut\",\n  \"country\": \"Lebanon\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "CREATED",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ],
          "cookie": [],
          "body": "{\"address\":\"Hamra, Beirut\",\"country\":\"Lebanon\",\"email\":\"omar@example.com\",\"name\":\"Omar Saleh\",\"phone\":\"01-555-0102\",\"user_id\":2}\n"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const responseData = pm.response.json();",
              "pm.test(\"User ID is generated\", () => pm.expect(responseData.user_id).to.be.a(\"number\"));",
              "pm.test(\"Created name matches\", () => pm.expect(responseData.name).to.eql(\"Omar Saleh\"));",
              "pm.environment.set(\"user_id\", responseData.user_id);"
            ]
          }
        }
      ]
    },
